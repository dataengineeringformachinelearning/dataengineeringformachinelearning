---
import { siteEnv } from '../lib/site-env';

const { FRONTEND_URL } = siteEnv();
const demlUrl = FRONTEND_URL.replace(/\/$/, '');
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="site-footer__inner">
		<nav class="site-footer__directory" aria-label="Footer">
			<div class="site-footer__column">
				<h2 class="site-footer__heading">Product</h2>
				<ul class="site-footer__list">
					<li><a href={demlUrl}>DEML</a></li>
					<li><a href={`${demlUrl}/explore`}>Explore</a></li>
					<li><a href={`${demlUrl}/signup`}>Sign up</a></li>
				</ul>
			</div>
			<div class="site-footer__column">
				<h2 class="site-footer__heading">Resources</h2>
				<ul class="site-footer__list">
					<li><a href={`${demlUrl}/blog`}>Blog</a></li>
					<li><a href="/whitepaper">Whitepaper</a></li>
					<li><a href="/book">Book</a></li>
				</ul>
			</div>
			<div class="site-footer__column">
				<h2 class="site-footer__heading">Support</h2>
				<ul class="site-footer__list">
					<li><a href={`${demlUrl}/status/platform-status`}>Platform Status</a></li>
				</ul>
			</div>
			<div class="site-footer__column">
				<h2 class="site-footer__heading">Legal &amp; Compliance</h2>
				<ul class="site-footer__list">
					<li><a href="/privacy">Privacy Policy</a></li>
					<li><a href="/terms">Terms of Service</a></li>
					<li><a href="/compliance">Compliance</a></li>
				</ul>
			</div>
		</nav>
		<div class="site-footer__bottom">
			<p class="site-footer__badge">Made in the U.S.A.</p>
			<p class="site-footer__copy">
				Copyright © {currentYear} Data Engineering for Machine Learning by
				<a href="https://joealongi.dev/" target="_blank" rel="noopener noreferrer">Joe Alongi</a>.
				All rights reserved.
			</p>
		</div>
	</div>
</footer>
