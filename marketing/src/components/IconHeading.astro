---
export interface Props {
  title: string;
  headingLevel?: 'h2' | 'h3';
  size?: 'md' | 'lg';
}

const { title, headingLevel = 'h3', size = 'md' } = Astro.props;
const HeadingTag = headingLevel;
---

<div class:list={['section-header', size === 'lg' && 'section-header--lg']}>
  <HeadingTag class="type-display">{title}</HeadingTag>
</div>
