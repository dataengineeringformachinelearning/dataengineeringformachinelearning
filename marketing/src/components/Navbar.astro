---
import { siteEnv } from '../lib/site-env';

const { FRONTEND_URL, BACKEND_URL, MARKETING_URL } = siteEnv();
const returnUrl = MARKETING_URL;
const pathname = Astro.url.pathname;

const navLinks = [
	{ id: 'book', label: 'Book', href: '/book' },
	{ id: 'whitepaper', label: 'Whitepaper', href: '/whitepaper' },
	{ id: 'documentation', label: 'Docs', href: '/documentation' },
	{ id: 'blog', label: 'Blog', href: '/blog' },
	{ id: 'compliance', label: 'Compliance', href: '/compliance' },
	{ id: 'deml', label: 'DEML', href: FRONTEND_URL },
] as const;

function isActive(href: string): boolean {
	if (href === '/') return pathname === '/' || pathname === '';
	if (href.startsWith('http')) return false;
	return pathname === href || pathname.startsWith(`${href.replace(/\/$/, '')}/`);
}
---

<script define:vars={{ FRONTEND_URL, BACKEND_URL, MARKETING_URL, returnUrl }}>
	window.__DEML = {
		...(window.__DEML || {}),
		FRONTEND_URL,
		BACKEND_URL,
		MARKETING_URL,
	};
</script>

<header class="site-navbar items-center" id="navbar">
	<div id="site-navbar-branding" class="site-navbar-branding row items-center">
		<a class="site-navbar-icon" href="/" aria-label="Go to homepage" id="navbar-brand-link">
			<svg
				xmlns="http://www.w3.org/2000/svg"
				width="20"
				height="20"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
				focusable="false"
			>
				<path d="M12 10.189V14"></path>
				<path d="M12 2v3"></path>
				<path d="M19 13V7a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v6"></path>
				<path
					d="M19.38 20A11.6 11.6 0 0 0 21 14l-8.188-3.639a2 2 0 0 0-1.624 0L3 14a11.6 11.6 0 0 0 2.81 7.76"
				></path>
				<path
					d="M2 21c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1s1.2 1 2.5 1c2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"
				></path>
			</svg>
		</a>
	</div>

	<button
		type="button"
		class="site-navbar-menu-toggle"
		id="mobile-menu-btn"
		aria-label="Open menu"
		aria-controls="site-navbar-panel"
		aria-expanded="false"
		aria-haspopup="true"
	>
		<svg
			class="site-navbar-menu-icon"
			data-icon="menu"
			xmlns="http://www.w3.org/2000/svg"
			width="32"
			height="32"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
			focusable="false"
		>
			<path d="M4 5h16"></path>
			<path d="M4 12h16"></path>
			<path d="M4 19h16"></path>
		</svg>
		<svg
			class="site-navbar-menu-icon"
			data-icon="close"
			hidden
			xmlns="http://www.w3.org/2000/svg"
			width="32"
			height="32"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
			focusable="false"
		>
			<path d="M18 6 6 18"></path>
			<path d="m6 6 12 12"></path>
		</svg>
	</button>

	<div class="site-navbar-panel" id="site-navbar-panel">
		<nav id="site-navigation" class="main-navigation place-center" aria-label="Primary">
			<ul class="row wrap items-center justify-center gap-4" role="list" id="site-navbar-menu">
				{
					navLinks.map((link) => (
						<li class="item-fixed">
							<a
								href={link.href}
								data-nav-id={link.id}
								class:list={{ 'is-active': isActive(link.href) }}
								aria-current={isActive(link.href) ? 'page' : undefined}
							>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<div class="button-group" data-layout="row" role="group" aria-label="Account actions" id="site-button-group">
			<button
				type="button"
				class="theme-toggle"
				id="theme-toggle-btn"
				aria-label="Toggle light and dark theme"
				aria-pressed="false"
			>
				<svg
					class="theme-toggle-icon"
					data-icon="sun"
					hidden
					xmlns="http://www.w3.org/2000/svg"
					width="20"
					height="20"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
					focusable="false"
				>
					<circle cx="12" cy="12" r="4"></circle>
					<path d="M12 2v2"></path>
					<path d="M12 20v2"></path>
					<path d="m4.93 4.93 1.41 1.41"></path>
					<path d="m17.66 17.66 1.41 1.41"></path>
					<path d="M2 12h2"></path>
					<path d="M20 12h2"></path>
					<path d="m6.34 17.66-1.41 1.41"></path>
					<path d="m19.07 4.93-1.41 1.41"></path>
				</svg>
				<svg
					class="theme-toggle-icon"
					data-icon="moon"
					xmlns="http://www.w3.org/2000/svg"
					width="20"
					height="20"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
					focusable="false"
				>
					<path
						d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"
					></path>
				</svg>
			</button>
			<a
				class="button button--secondary button--pill"
				href={`${FRONTEND_URL}/login?returnUrl=${encodeURIComponent(returnUrl)}`}
				id="auth-btn-login"
			>
				Log in
			</a>
			<a class="button button--primary button--pill" href={`${FRONTEND_URL}/signup`} id="auth-btn-signup">
				Sign up
			</a>
		</div>
	</div>
</header>

<style is:global>
	.theme-toggle svg[hidden],
	.site-navbar-menu-toggle svg[hidden] {
		display: none !important;
	}
</style>

<script is:inline>
	(() => {
		const navbar = document.getElementById('navbar');
		const menuBtn = document.getElementById('mobile-menu-btn');
		const themeBtn = document.getElementById('theme-toggle-btn');
		const panel = document.getElementById('site-navbar-panel');
		const main = document.getElementById('main-content');
		if (!navbar || !menuBtn) return;

		const menuIcon = menuBtn.querySelector('[data-icon="menu"]');
		const closeIcon = menuBtn.querySelector('[data-icon="close"]');
		const sunIcon = themeBtn?.querySelector('[data-icon="sun"]');
		const moonIcon = themeBtn?.querySelector('[data-icon="moon"]');
		const mq = window.matchMedia('(min-width: 800px)');

		const focusables = () =>
			Array.from(
				navbar.querySelectorAll(
					'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])',
				),
			).filter((node) => {
				const style = window.getComputedStyle(node);
				return style.display !== 'none' && style.visibility !== 'hidden';
			});

		const setMainInert = (inert) => {
			if (!main) return;
			if (inert) main.setAttribute('inert', '');
			else main.removeAttribute('inert');
		};

		const setMenuOpen = (open, { returnFocus = false } = {}) => {
			navbar.classList.toggle('is-menu-open', open);
			menuBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
			menuBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
			document.body.style.overflow = open ? 'hidden' : '';
			setMainInert(open);
			if (menuIcon) menuIcon.hidden = open;
			if (closeIcon) closeIcon.hidden = !open;
			if (panel) {
				if (open) {
					panel.setAttribute('role', 'dialog');
					panel.setAttribute('aria-modal', 'true');
					panel.setAttribute('aria-label', 'Site menu');
					const first = panel.querySelector(
						'a[href], button:not([disabled])',
					);
					first?.focus?.();
				} else {
					panel.removeAttribute('role');
					panel.removeAttribute('aria-modal');
					panel.removeAttribute('aria-label');
					if (returnFocus) menuBtn.focus();
				}
			}
		};

		menuBtn.addEventListener('click', () => {
			const open = !navbar.classList.contains('is-menu-open');
			setMenuOpen(open, { returnFocus: !open });
		});

		navbar.querySelectorAll('#site-navbar-menu a').forEach((link) => {
			link.addEventListener('click', () => setMenuOpen(false));
		});

		document.addEventListener('keydown', (event) => {
			if (!navbar.classList.contains('is-menu-open')) return;
			if (event.key === 'Escape') {
				event.preventDefault();
				setMenuOpen(false, { returnFocus: true });
				return;
			}
			if (event.key !== 'Tab') return;
			const nodes = focusables();
			if (nodes.length === 0) return;
			const first = nodes[0];
			const last = nodes[nodes.length - 1];
			const active = document.activeElement;
			if (event.shiftKey && active === first) {
				event.preventDefault();
				last.focus();
			} else if (!event.shiftKey && active === last) {
				event.preventDefault();
				first.focus();
			}
		});

		const onBreakpoint = () => {
			if (mq.matches) setMenuOpen(false);
		};
		mq.addEventListener('change', onBreakpoint);

		if (themeBtn) {
			const applyTheme = (theme) => {
				document.documentElement.setAttribute('data-theme', theme);
				document.documentElement.classList.toggle('dark', theme === 'dark');
				localStorage.setItem('deml-theme', theme);
				themeBtn.setAttribute('aria-pressed', theme === 'dark' ? 'true' : 'false');
				themeBtn.setAttribute(
					'aria-label',
					theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode',
				);
				if (sunIcon) sunIcon.hidden = theme !== 'dark';
				if (moonIcon) moonIcon.hidden = theme === 'dark';
			};

			// Prefer deml-theme; migrate legacy `theme` once if needed.
			let stored = localStorage.getItem('deml-theme');
			const legacy = localStorage.getItem('theme');
			if (
				(stored !== 'light' && stored !== 'dark') &&
				(legacy === 'light' || legacy === 'dark')
			) {
				stored = legacy;
				localStorage.setItem('deml-theme', legacy);
			}
			const current =
				stored === 'light' || stored === 'dark'
					? stored
					: document.documentElement.getAttribute('data-theme') === 'light'
						? 'light'
						: 'dark';
			applyTheme(current);

			themeBtn.addEventListener('click', () => {
				const next =
					document.documentElement.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
				applyTheme(next);
			});
		}
	})();
</script>
