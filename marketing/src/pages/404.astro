---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Not found — DEML"
  description="This page does not exist."
  robots="noindex, nofollow"
>
  <div class="page">
    <section class="banner banner--hero" data-variant="hero" aria-labelledby="not-found-title">
      <p class="preheader">404</p>
      <h1 class="banner-heading" id="not-found-title">Page not found</h1>
      <p class="lede">That URL is not on this site.</p>
      <div class="banner-actions">
        <div class="button-group" data-layout="row" role="group" aria-label="Recovery">
          <a href="/" class="button button--primary button--pill">Home</a>
          <a href="/book" class="button button--secondary button--pill">Book</a>
        </div>
      </div>
    </section>
  </div>
</Layout>
