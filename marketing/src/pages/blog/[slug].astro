---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import {
	blueNoteHref,
	formatBlueNoteDate,
	getBlueNotes,
	type BlueNote,
} from '../../lib/blue-notes';
import { blogPostingJsonLd, canonicalHref } from '../../lib/seo';
import { siteEnv } from '../../lib/site-env';

export const getStaticPaths = async () => {
	const notes = await getBlueNotes();

	return notes.map((note) => ({
		params: { slug: note.id },
		props: { note },
	}));
};

interface Props {
	note: BlueNote;
}

const { note } = Astro.props;
const notes = await getBlueNotes();
const noteIndex = notes.findIndex((candidate) => candidate.id === note.id);
const newerNote = noteIndex > 0 ? notes[noteIndex - 1] : undefined;
const olderNote = noteIndex >= 0 ? notes[noteIndex + 1] : undefined;
const { Content, headings } = await render(note);
const outlineHeadings = headings.filter((heading) => heading.depth === 2);
const hasOutline = outlineHeadings.length > 0;
const { MARKETING_URL } = siteEnv();
const noteUrl = canonicalHref(blueNoteHref(note), MARKETING_URL);
const pageTitle = `${note.data.title} — DEML Blue Notes`;
const jsonLd = blogPostingJsonLd(
	note.data.title,
	note.data.summary,
	noteUrl,
	note.data.publishedAt,
	note.data.updatedAt,
);
---

<Layout
	title={pageTitle}
	description={note.data.summary}
	keywords={[...note.data.categories, 'DEML Blue Notes', 'platform changelog'].join(', ')}
	ogType="article"
	jsonLd={jsonLd}
>
	<div class="page page--prose">
		<section class="banner" aria-labelledby="note-title">
			<p class="page-header__meta">
				<a href="/blog/">Blue Notes</a>
				<span class="page-header__meta-sep" aria-hidden="true">/</span>
				<span aria-current="page">{note.data.note}</span>
			</p>
			<p class="preheader">
				<span class="badge" data-tone="info">{note.data.note}</span>
				{' '}
				<time datetime={note.data.publishedAt.toISOString()}>
					{formatBlueNoteDate(note.data.publishedAt)}
				</time>
			</p>
			<h1 class="banner-heading" id="note-title">{note.data.title}</h1>
			<p class="lede">{note.data.summary}</p>
			<aside class="cluster" aria-label="Categories">
				{note.data.categories.map((category) => (
					<span class="badge" data-tone="neutral">
						{category}
					</span>
				))}
			</aside>
			<div class="banner-actions no-print">
				<a class="page-back-link" href="/blog/">← All Blue Notes</a>
			</div>
		</section>

		<section class="page-body page-body--prose stack">
			{
				hasOutline && (
					<nav class="toc no-print" aria-label="On this page">
						<h2 class="toc__heading">In this note</h2>
						<ol class="toc__list">
							{outlineHeadings.map((heading) => (
								<li>
									<a class="toc__item" href={`#${heading.slug}`}>
										<span class="toc__num">§</span>
										<span class="toc__label">{heading.text}</span>
									</a>
								</li>
							))}
						</ol>
					</nav>
				)
			}

			<article class="article">
				<div class="article-body">
					<Content />
				</div>
			</article>

			<aside class="callout" data-tone="info" role="note">
				<div class="callout__body">
					<p class="callout__heading">Living release record</p>
					<p class="callout__text">
						Blue Notes summarize shipped outcomes. The public repository remains the detailed
						engineering record.
					</p>
				</div>
				<a
					class="button button--secondary button--pill"
					href="https://github.com/dataengineeringformachinelearning/dataengineeringformachinelearning"
					target="_blank"
					rel="noopener noreferrer"
				>
					View source
				</a>
			</aside>

			<nav class="pagination no-print" aria-label="Blue Note navigation">
				{
					olderNote ? (
						<a class="pagination__prev" href={blueNoteHref(olderNote)} rel="prev">
							Earlier: {olderNote.data.title}
						</a>
					) : (
						<span class="pagination__prev" aria-disabled="true">
							Earlier note
						</span>
					)
				}
				{
					newerNote ? (
						<a class="pagination__next" href={blueNoteHref(newerNote)} rel="next">
							Newer: {newerNote.data.title}
						</a>
					) : (
						<span class="pagination__next" aria-disabled="true">
							Newer note
						</span>
					)
				}
			</nav>
		</section>
	</div>
</Layout>
