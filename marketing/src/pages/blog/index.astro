---
import Layout from '../../layouts/Layout.astro';
import { blueNoteHref, formatBlueNoteDate, getBlueNotes } from '../../lib/blue-notes';
import { blogJsonLd, canonicalHref, webPageJsonLd } from '../../lib/seo';
import { siteEnv } from '../../lib/site-env';

const notes = await getBlueNotes();
const [latestNote, ...archiveNotes] = notes;
const pageTitle = 'Blog — DEML Platform Changes';
const pageDescription =
	'A chronological field log of DEML platform releases, architectural changes, reliability work, and new operator capabilities.';
const { MARKETING_URL } = siteEnv();
const pageUrl = canonicalHref('/blog/', MARKETING_URL);
const pageJsonLd = [
	blogJsonLd(MARKETING_URL, pageUrl),
	webPageJsonLd(pageTitle, pageDescription, pageUrl),
	{
		'@context': 'https://schema.org',
		'@type': 'ItemList',
		name: 'DEML Blog',
		itemListOrder: 'https://schema.org/ItemListOrderDescending',
		numberOfItems: notes.length,
		itemListElement: notes.map((note, index) => ({
			'@type': 'ListItem',
			position: index + 1,
			name: note.data.title,
			url: canonicalHref(blueNoteHref(note), MARKETING_URL),
		})),
	},
];
---

<Layout
	title={pageTitle}
	description={pageDescription}
	keywords="DEML changelog, release notes, platform updates, product blog, data engineering, AI engineering, cybersecurity"
	ogType="website"
	rssHref="/blog/rss.xml"
	jsonLd={pageJsonLd}
>
	<div class="page page--prose">
		<section class="banner" data-variant="hero" aria-labelledby="blog-title">
			<p class="preheader">Field log</p>
			<h1 class="banner-heading" id="blog-title">Blog</h1>
			<p class="lede">
				Releases, architecture decisions, and reliability notes from building DEML in public.
			</p>
			<div class="banner-actions">
				<div class="button-group" data-layout="row" role="group" aria-label="Blog actions">
					<a class="button button--secondary button--pill" href="/blog/rss.xml">RSS</a>
					<a class="button button--ghost button--pill" href="/documentation">Docs</a>
				</div>
			</div>
		</section>

		<section class="page-body page-body--prose stack" aria-labelledby="blog-archive-title">
			{
				latestNote && (
					<section aria-labelledby="latest-post-title">
						<header class="section-header">
							<p class="type-eyebrow">Latest</p>
							<h2 class="type-display" id="latest-post-title">
								Newest note
							</h2>
						</header>
						<a
							class="card"
							data-layout="teaser"
							data-visual="olive"
							href={blueNoteHref(latestNote)}
						>
							<div class="card-copy">
								<p class="card-meta">
									{latestNote.data.note}
									{' · '}
									<time datetime={latestNote.data.publishedAt.toISOString()}>
										{formatBlueNoteDate(latestNote.data.publishedAt)}
									</time>
								</p>
								<h3 class="card-heading">{latestNote.data.title}</h3>
								<p class="card-subtext">{latestNote.data.summary}</p>
								{
									latestNote.data.categories.length > 0 && (
										<div class="cluster" aria-label="Categories">
											{latestNote.data.categories.map((category) => (
												<span class="badge" data-tone="neutral">
													{category}
												</span>
											))}
										</div>
									)
								}
							</div>
						</a>
					</section>
				)
			}

			{
				archiveNotes.length > 0 && (
					<section aria-labelledby="blog-archive-title">
						<header class="section-header">
							<p class="type-eyebrow">Archive</p>
							<h2 class="type-display" id="blog-archive-title">
								Earlier posts
							</h2>
							<p class="type-intro">{archiveNotes.length} notes · newest first</p>
						</header>
						<div class="card-grid" data-density="compact" role="list" aria-label="Blog archive">
							{archiveNotes.map((note) => (
								<a
									class="card"
									data-layout="teaser"
									href={blueNoteHref(note)}
									role="listitem"
								>
									<div class="card-copy">
										<p class="card-meta">
											{note.data.note}
											{' · '}
											<time datetime={note.data.publishedAt.toISOString()}>
												{formatBlueNoteDate(note.data.publishedAt)}
											</time>
										</p>
										<h3 class="card-heading">{note.data.title}</h3>
										<p class="card-subtext">{note.data.summary}</p>
									</div>
								</a>
							))}
						</div>
					</section>
				)
			}

			<aside class="callout" data-tone="info" role="note">
				<div class="callout__body">
					<p class="callout__heading">Living release record</p>
					<p class="callout__text">
						Posts summarize shipped outcomes. The public repository remains the detailed
						engineering record.
					</p>
				</div>
				<a
					class="button button--secondary button--pill"
					href="https://github.com/dataengineeringformachinelearning/dataengineeringformachinelearning"
					target="_blank"
					rel="noopener noreferrer"
				>
					View source
				</a>
			</aside>
		</section>
	</div>
</Layout>
