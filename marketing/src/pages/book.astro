---
import Layout from '../layouts/Layout.astro';
import { loadBookChapters, SIDEBAR_GROUPS } from '../lib/book-chapters';
import { bookJsonLd, canonicalHref } from '../lib/seo';
import { siteEnv } from '../lib/site-env';

const chapters = loadBookChapters();
const { MARKETING_URL } = siteEnv();
const pageTitle = 'The Book — DEML Platform';
const pageDescription =
	'Authoritative build specification for operational intelligence on the digital battlefield — interactive chapters, deployment notes, and annotated architectural walkthroughs.';
const firstChapter = chapters.find((chapter) => chapter.slug !== 'cover') ?? chapters[1] ?? chapters[0];
const bookJsonLdPayload = bookJsonLd(pageTitle, pageDescription, canonicalHref('/book', MARKETING_URL));
const chapterCount = Math.max(chapters.length - 1, 0);
---

<Layout
	title={pageTitle}
	description={pageDescription}
	keywords="data engineering book, ai engineering guide, cybersecurity, MLOps deployment, DEML chapters, cloud run deployment"
	ogType="book"
	jsonLd={bookJsonLdPayload}
>
	<div class="page page--prose">
		<header class="page-header">
			<div class="page-header__text">
				<p class="page-header__eyebrow">Interactive reference · {chapterCount} chapters</p>
				<h1 class="page-header__title">Data Engineering for Machine Learning</h1>
				<p class="page-header__lede">
					Operational intelligence for the digital battlefield — authoritative specification,
					interactive chapters, and reference material for security engineers.
				</p>
				<p class="page-header__meta">
					<a href="/documentation">Integration Guides</a>
					<span class="page-header__meta-sep" aria-hidden="true">·</span>
					<a href="/whitepaper">The Whitepaper</a>
					<span class="page-header__meta-sep" aria-hidden="true">·</span>
					<a
						href="https://github.com/dataengineeringformachinelearning/deml/blob/main/THEME.md"
						target="_blank"
						rel="noopener noreferrer"
					>
						THEME.md
					</a>
				</p>
			</div>
			{
				firstChapter && (
					<div class="page-header__actions">
						<div class="button-group" data-layout="row" role="group" aria-label="Book actions">
							<a class="button button--primary button--pill" href={`/book/${firstChapter.slug}/`}>
								Start reading
							</a>
							<a class="button button--secondary button--pill" href="/whitepaper">
								Whitepaper
							</a>
						</div>
					</div>
				)
			}
		</header>

		<section class="page-body page-body--prose" aria-labelledby="book-contents-heading">
			<nav class="toc" aria-labelledby="book-contents-heading">
				<h2 class="toc__heading" id="book-contents-heading">Contents</h2>
				{
					SIDEBAR_GROUPS.map((group) => {
						const groupChapters = chapters.filter((chapter) => chapter.group === group);
						if (groupChapters.length === 0) return null;
						return (
							<div class="toc__group">
								<h3 class="toc__group-title">{group}</h3>
								<ol class="toc__list">
									{groupChapters.map((chapter) => (
										<li>
											<a class="toc__item" href={`/book/${chapter.slug}/`}>
												<span class="toc__num">{chapter.num || '—'}</span>
												<span class="toc__label">{chapter.shortTitle}</span>
											</a>
										</li>
									))}
								</ol>
							</div>
						);
					})
				}
			</nav>
		</section>
	</div>
</Layout>
