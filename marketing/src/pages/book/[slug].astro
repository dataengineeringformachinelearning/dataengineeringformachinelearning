---
import Layout from '../../layouts/Layout.astro';
import { loadBookChapters, SIDEBAR_GROUPS } from '../../lib/book-chapters';
import { bookJsonLd, canonicalHref } from '../../lib/seo';
import { siteEnv } from '../../lib/site-env';

export function getStaticPaths() {
	const chapters = loadBookChapters();
	return chapters.map((chapter) => ({
		params: { slug: chapter.slug },
		props: { chapter, chapters },
	}));
}

const { chapter, chapters } = Astro.props;
const { MARKETING_URL } = siteEnv();
const pageTitle = `${chapter.title} - The Book - DEML Platform`;
const pageDescription = `Chapter from Data Engineering for Machine Learning: ${chapter.title}`;
const bookJsonLdPayload = bookJsonLd(
	pageTitle,
	pageDescription,
	canonicalHref(`/book/${chapter.slug}`, MARKETING_URL),
);
const progressPct = Math.round(((chapter.index + 1) / chapters.length) * 100);
const prevChapter = chapter.index > 0 ? chapters[chapter.index - 1] : null;
const nextChapter = chapter.index < chapters.length - 1 ? chapters[chapter.index + 1] : null;
const isCover = chapter.slug === 'cover';
---

<Layout
	title={pageTitle}
	description={pageDescription}
	keywords="data engineering book, ai engineering guide, cybersecurity, MLOps deployment, DEML chapters"
	ogType="article"
	jsonLd={bookJsonLdPayload}
>
	<div class="app-layout app-layout--embedded app-layout--book" id="book-app">
		<div class="app-layout__body">
			<aside class="app-layout__nav no-print" aria-label="Chapter list">
				<a class="page-back-link" href="/book/">All chapters</a>
				<details class="book-toc" open>
					<summary>Contents</summary>
					<nav class="toc" aria-label="Book chapters">
						{
							SIDEBAR_GROUPS.map((group) => {
								const groupChapters = chapters.filter((item) => item.group === group);
								if (groupChapters.length === 0) return null;
								return (
									<div class="toc__group">
										<h3 class="toc__group-title">{group}</h3>
										<ol class="toc__list">
											{groupChapters.map((item) => (
												<li>
													<a
														class="toc__item"
														href={`/book/${item.slug}/`}
														aria-current={item.slug === chapter.slug ? 'page' : undefined}
													>
														<span class="toc__num">{item.num || '—'}</span>
														<span class="toc__label">{item.shortTitle}</span>
													</a>
												</li>
											))}
										</ol>
									</div>
								);
							})
						}
					</nav>
				</details>
			</aside>

			<main class="app-layout__main">
				<div class="app-layout__content stack">
					{
						!isCover && (
							<header class="page-header">
								<div class="page-header__text">
									<p class="page-header__eyebrow">
										{chapter.group}
										{chapter.num ? ` · #${chapter.num}` : ''}
									</p>
									<h1 class="page-header__title">{chapter.shortTitle}</h1>
									<div class="page-header__progress no-print">
										<div class="page-header__progress-label">
											<span>Reading progress</span>
											<span>{progressPct}%</span>
										</div>
										<progress
											class="progress__control"
											value={progressPct}
											max="100"
											data-tone="info"
											aria-label={`Reading progress: ${progressPct}%`}
										/>
									</div>
								</div>
							</header>
						)
					}

					<article class="article module">
						<div class="article-body">
							{
								isCover ? (
									<div class="card" data-visual="olive">
										<div class="card-copy">
											<p class="page-header__eyebrow">Interactive guide</p>
											<h1 class="card-heading">
												Data Engineering
												<br />
												for Machine Learning
											</h1>
											<p class="card-subtext">Building high-throughput event platforms</p>
											<div class="card-actions">
												<div
													class="button-group"
													data-layout="row"
													role="group"
													aria-label="Cover links"
												>
													<a
														class="button button--secondary button--pill"
														href="https://joealongi.dev/"
														target="_blank"
														rel="noopener noreferrer"
													>
														Joe Alongi
													</a>
													<span class="badge">Vol. I</span>
												</div>
											</div>
										</div>
										<div class="card-media has-visual" aria-hidden="true" />
									</div>
								) : (
									<div set:html={chapter.html} />
								)
							}
						</div>
					</article>

					<nav class="pagination no-print" aria-label="Chapter navigation">
						{
							prevChapter ? (
								<a class="pagination__prev" href={`/book/${prevChapter.slug}/`}>
									Previous
								</a>
							) : (
								<span class="pagination__prev" aria-disabled="true">
									Previous
								</span>
							)
						}
						<span class="badge">
							Chapter {chapter.index + 1} of {chapters.length}
						</span>
						{
							nextChapter ? (
								<a class="pagination__next" href={`/book/${nextChapter.slug}/`}>
									Next
								</a>
							) : (
								<span class="pagination__next" aria-disabled="true">
									Next
								</span>
							)
						}
					</nav>
				</div>
			</main>
		</div>
	</div>
</Layout>

<script is:inline>
	(() => {
		const toc = document.querySelector('#book-app .book-toc');
		if (!(toc instanceof HTMLDetailsElement)) return;
		const mq = window.matchMedia('(min-width: 800px)');
		const sync = () => {
			if (mq.matches) toc.open = true;
		};
		sync();
		mq.addEventListener('change', sync);
	})();
</script>
