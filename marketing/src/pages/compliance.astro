---
import Layout from '../layouts/Layout.astro';
import { siteEnv } from '../lib/site-env';
import { webPageJsonLd, canonicalHref } from '../lib/seo';

const { FRONTEND_URL, MARKETING_URL } = siteEnv();
const platformStatusHref = `${FRONTEND_URL.replace(/\/$/, '')}/status/platform-status`;
const pageTitle = 'Compliance — DEML Platform';
const pageDescription =
  'Security controls, encryption practices, and audit-ready compliance notes for the DEML platform.';
const complianceJsonLd = webPageJsonLd(
  pageTitle,
  pageDescription,
  canonicalHref('/compliance', MARKETING_URL),
);
---

<Layout
  title={pageTitle}
  description={pageDescription}
  keywords="SOC2 compliance, DEML security, data retention, encryption, audit controls"
  jsonLd={complianceJsonLd}
>
  <div class="page page--prose">
    <section class="banner" data-variant="hero" aria-labelledby="compliance-title">
      <p class="preheader">Security</p>
      <h1 class="banner-heading" id="compliance-title">Compliance</h1>
      <p class="lede">
        How DEML protects data, controls access, and supports audit readiness. Check live platform
        health on the status page.
      </p>
      <div class="banner-actions">
        <a class="button button--secondary button--pill" href={platformStatusHref}>Platform status</a>
      </div>
    </section>

    <section class="page-body page-body--prose stack" aria-labelledby="controls-heading">
      <header class="section-header">
        <p class="type-eyebrow">Controls</p>
        <h2 class="type-display" id="controls-heading">What we hold ourselves to</h2>
      </header>

      <article class="article">
        <div class="article-body">
          <h3>Encryption</h3>
          <ul>
            <li>TLS 1.3 in transit</li>
            <li>AES-256 at rest with cloud KMS</li>
            <li>Integrity checks on encrypted event ingest paths</li>
          </ul>

          <h3>Access</h3>
          <ul>
            <li>Strong authentication at the DEML product edge</li>
            <li>Service credentials for integrations — end-user tokens are never forwarded</li>
            <li>Roles and consent managed in your DEML account</li>
          </ul>

          <h3>Assurance</h3>
          <ul>
            <li>SOC 2 control map maintained as a living reference</li>
            <li>Independent verification required for audit evidence</li>
            <li>Privacy and terms published on this site</li>
          </ul>
        </div>
      </article>
    </section>
  </div>
</Layout>
