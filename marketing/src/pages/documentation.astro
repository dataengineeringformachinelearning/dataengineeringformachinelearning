---
import Layout from '../layouts/Layout.astro';
import { siteEnv } from '../lib/site-env';

const { FRONTEND_URL } = siteEnv();
const destination = `${FRONTEND_URL.replace(/\/$/, '')}/#docs`;
const pageTitle = 'Developer Portal — moved to DEML';
const pageDescription =
  'DEML product documentation and quick start now live on the DEML product showcase.';
---

<Layout title={pageTitle} description={pageDescription} robots="noindex, follow">
  <div class="page-inner-wrapper community-home">
    <section class="community-hero" aria-labelledby="docs-redirect-title">
      <h1 id="docs-redirect-title">Documentation has moved</h1>
      <p>
        Product docs and quick start now live on the
        <a href={destination}>DEML product showcase</a>.
      </p>
      <p>
        <a class="viking-btn viking-btn-primary" href={destination}>Continue to DEML</a>
      </p>
    </section>
  </div>
</Layout>

<script define:vars={{ destination }}>
  window.location.replace(destination);
</script>
