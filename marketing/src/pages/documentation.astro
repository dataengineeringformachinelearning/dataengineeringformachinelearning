---
import Layout from '../layouts/Layout.astro';
import { siteEnv } from '../lib/site-env';

const { BACKEND_URL } = siteEnv();
const destination = `${BACKEND_URL.replace(/\/$/, '')}/documentation`;
const pageTitle = 'Developer Portal — DEML API docs';
const pageDescription =
  'DEML developer documentation, integrations, and API references on the control-plane backend.';
---

<Layout title={pageTitle} description={pageDescription} robots="noindex, follow">
  <div class="page-inner-wrapper community-home">
    <section class="community-hero" aria-labelledby="docs-redirect-title">
      <h1 id="docs-redirect-title">Documentation has moved</h1>
      <p>
        Product docs and integration guides now live on the
        <a href={destination}>DEML developer portal</a>.
      </p>
      <p>
        <a class="viking-btn viking-btn-primary" href={destination}>Continue to documentation</a>
      </p>
    </section>
  </div>
</Layout>

<script define:vars={{ destination }}>
  window.location.replace(destination);
</script>
