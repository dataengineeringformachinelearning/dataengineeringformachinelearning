---
import Layout from '../layouts/Layout.astro';
import { siteEnv } from '../lib/site-env';
import {
  DEFAULT_KEYWORDS,
  organizationJsonLd,
  webSiteJsonLd,
} from '../lib/seo';

const { FRONTEND_URL, MARKETING_URL } = siteEnv();
const demlUrl = FRONTEND_URL.replace(/\/$/, '');
const marketingUrl = MARKETING_URL.replace(/\/$/, '');
const pageTitle = 'Data Engineering for Machine Learning — Community';
const pageDescription =
  'Learn data engineering for machine learning — open book, whitepaper, blog, and docs. Build and publish status with DEML.';
const homeJsonLd = [organizationJsonLd(MARKETING_URL), webSiteJsonLd(MARKETING_URL)];

/** Keep in sync with deml `SUITE_CONTINUE_LINKS` / `SUITE_CONTINUE` in src/app/data/home.ts */
const suiteContinue = {
  headingId: 'suite-continue-heading',
  eyebrow: 'Suite',
  heading: 'Continue across the suite',
  links: [
    {
      num: '01',
      label: 'Book',
      description: 'Chapters on building production data and ML systems.',
      href: `${marketingUrl}/book`,
    },
    {
      num: '02',
      label: 'Whitepaper',
      description: 'Architecture and operations narrative for the suite.',
      href: `${marketingUrl}/whitepaper`,
    },
    {
      num: '03',
      label: 'Blog',
      description: 'Notes and updates from the DEML community.',
      href: `${marketingUrl}/blog`,
    },
    {
      num: '04',
      label: 'Docs',
      description: 'How to run, extend, and integrate the platforms.',
      href: `${marketingUrl}/documentation`,
    },
    {
      num: '05',
      label: 'Explore',
      description: 'Public status pages you can open and share.',
      href: `${demlUrl}/explore`,
    },
  ],
} as const;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  keywords={DEFAULT_KEYWORDS}
  jsonLd={homeJsonLd}
>
  <div class="page">
    <section class="banner banner--hero" data-variant="hero" aria-labelledby="main-title">
      <p class="preheader">DEML</p>
      <h1 class="banner-heading" id="main-title">Data engineering for machine learning.</h1>
      <p class="lede">
        Open book, whitepaper, and blog for builders. Use DEML when you’re ready to publish status.
      </p>
      <div class="banner-actions">
        <div class="button-group" data-layout="row" role="group" aria-label="Primary actions">
          <a class="button button--primary button--pill" href="/book">Book</a>
          <a class="button button--secondary button--pill" href={demlUrl}>Open DEML</a>
        </div>
      </div>
    </section>

    <section class="page-body" aria-labelledby={suiteContinue.headingId}>
      <div class="stack">
        <header class="section-header">
          <p class="section-header-eyebrow type-eyebrow">{suiteContinue.eyebrow}</p>
          <h2 class="section-header-heading type-display" id={suiteContinue.headingId}>
            {suiteContinue.heading}
          </h2>
        </header>

        <div class="card-grid" data-density="compact" data-columns="3">
          {
            suiteContinue.links.map((item) => (
              <a class="card" data-layout="teaser" data-visual="olive" href={item.href}>
                <div class="card-copy">
                  <p class="card-meta">{item.num}</p>
                  <h3 class="card-heading">{item.label}</h3>
                  <p class="card-subtext">{item.description}</p>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </div>
</Layout>
