---
import Layout from '../layouts/Layout.astro';
import { siteEnv } from '../lib/site-env';
import {
  DEFAULT_KEYWORDS,
  organizationJsonLd,
  webSiteJsonLd,
} from '../lib/seo';

const { FRONTEND_URL, MARKETING_URL } = siteEnv();
const FORJD_URL = 'https://backend.forjd.co';
const platformStatusHref = `${FRONTEND_URL.replace(/\/$/, '')}/status/platform-status`;
const pageTitle = 'Data Engineering for Machine Learning — Community';
const pageDescription =
  'Learn data engineering for machine learning with living platforms — FORJD for secure streaming, DEML for the learning control plane.';
const homeJsonLd = [organizationJsonLd(MARKETING_URL), webSiteJsonLd(MARKETING_URL)];

const platforms = [
  {
    title: 'FORJD',
    summary: 'Secure streaming engine for sealed ingest, workflows, and production pipelines.',
    href: FORJD_URL,
    external: true,
  },
  {
    title: 'DEML',
    summary: 'Learning control plane — identity, dashboards, and status that call FORJD.',
    href: FRONTEND_URL,
    external: false,
  },
] as const;

const resources = [
  {
    title: 'Blue Notes',
    description: 'Field notes from building data platforms for ML.',
    href: '/blog/',
  },
  {
    title: 'Book',
    description: 'Architecture narrative and operational chapters.',
    href: '/book',
  },
  {
    title: 'Whitepaper',
    description: 'A short brief on defendable data platforms.',
    href: '/whitepaper',
  },
] as const;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  keywords={`${DEFAULT_KEYWORDS}, community, learning, open examples`}
  jsonLd={homeJsonLd}
>
  <div class="page-inner-wrapper">
    <section class="banner banner--hero" aria-labelledby="main-title">
      <p class="preheader">Community</p>
      <h1 class="banner-heading" id="main-title">Data Engineering for Machine Learning</h1>
      <p class="lede">
        Learn the practice with living platforms — field notes, a book, and systems you can actually run.
      </p>
      <div class="banner-actions">
        <div class="button-group">
          <a class="button button--primary" href={FRONTEND_URL}>Open DEML</a>
          <a
            class="button button--secondary"
            href={FORJD_URL}
            target="_blank"
            rel="noopener noreferrer"
          >FORJD API</a>
          <a class="button button--secondary" href="/blog/">Blue Notes</a>
        </div>
      </div>
    </section>

    <section class="page-section" aria-labelledby="platforms-title">
      <header class="section-header">
        <h2 class="type-display" id="platforms-title">Platforms</h2>
        <p class="type-intro">Two living systems for learning data engineering for ML.</p>
      </header>
      <div class="page-section__body">
        <div class="card-grid" data-density="compact" data-columns="2">
          {platforms.map((item) => (
            <a
              class="card"
              data-layout="teaser"
              href={item.href}
              {...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              <div class="card-copy">
                <h3 class="card-heading">{item.title}</h3>
                <p class="card-subtext">{item.summary}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="page-section" aria-labelledby="resources-title">
      <header class="section-header">
        <h2 class="type-display" id="resources-title">Resources</h2>
        <p class="type-intro">Start here — notes, book, and whitepaper.</p>
      </header>
      <div class="page-section__body">
        <div class="card-grid" data-density="compact" data-columns="3">
          {resources.map((item) => (
            <a class="card" data-layout="teaser" href={item.href}>
              <div class="card-copy">
                <h3 class="card-heading">{item.title}</h3>
                <p class="card-subtext">{item.description}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <p>
      <a href={platformStatusHref}>DEML platform status</a>
    </p>
  </div>
</Layout>
