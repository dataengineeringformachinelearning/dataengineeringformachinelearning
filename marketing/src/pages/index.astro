---
import Layout from '../layouts/Layout.astro';
import VikingIcon from '../components/VikingIcon.astro';
import { siteEnv } from '../lib/site-env';
import {
  DEFAULT_KEYWORDS,
  organizationJsonLd,
  webSiteJsonLd,
} from '../lib/seo';

const { FRONTEND_URL, MARKETING_URL } = siteEnv();
const FORJD_URL = 'https://forjd.co';
const pageTitle = 'Data Engineering for Machine Learning — Community';
const pageDescription =
  'A community for practitioners learning and building data engineering for machine learning — open examples, field notes, and shared reference platforms.';
const homeJsonLd = [organizationJsonLd(MARKETING_URL), webSiteJsonLd(MARKETING_URL)];

const showcases = [
  {
    id: 'forjd',
    tag: 'PRIMARY · DATA PLANE',
    title: 'FORJD',
    summary:
      'Universal secure streaming engine — sealed ingest, YAML workflows, durable projections, analytics, and a Rust hot path for production pipelines.',
    href: FORJD_URL,
    cta: 'Open FORJD',
    icon: 'hub',
  },
  {
    id: 'deml',
    tag: 'LEARNING · CONTROL PLANE',
    title: 'DEML',
    summary:
      'Learning library and Firebase-authenticated control plane — identity, billing, consent, dashboards, and status surfaces that call FORJD.',
    href: FRONTEND_URL,
    cta: 'Open DEML',
    icon: 'analytics',
  },
] as const;

const resources = [
  {
    title: 'Blue Notes',
    description: 'Field logs and community changelog from the practice of data engineering for ML.',
    href: '/blog/',
    icon: 'insights',
  },
  {
    title: 'Book',
    description: 'Architecture narrative and operational chapters for the community.',
    href: '/book',
    icon: 'description',
  },
  {
    title: 'Whitepaper',
    description: 'Concise value proposition and diagrams for defendable data platforms.',
    href: '/whitepaper',
    icon: 'policy',
  },
] as const;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  keywords={`${DEFAULT_KEYWORDS}, community, learning, open examples`}
  jsonLd={homeJsonLd}
>
  <div class="page-inner-wrapper landing-container showcase-layout community-home suite-landing">
    <section class="suite-landing-hero viking-unified-hero" aria-labelledby="main-title">
      <p class="hero-badge viking-unified-hero-badge community-eyebrow">
        <span class="badge-dot pulse-dot"></span>
        <span class="badge-text">Community · Practice · Platforms</span>
      </p>
      <h1 class="title viking-unified-hero-title" id="main-title">
        Data Engineering for Machine Learning
      </h1>
      <p class="subtitle viking-unified-hero-lead suite-landing-lede">
        Learn and build the practice of data engineering for machine learning — share field notes,
        study living reference platforms, and grow skills that hold up under production pressure.
      </p>
      <div class="cta-group viking-unified-hero-actions suite-landing-actions">
        <a class="suite-btn viking-btn viking-btn-primary" data-variant="primary" href={FORJD_URL}
          >Open FORJD</a
        >
        <a class="suite-btn viking-btn viking-btn-outline" data-variant="outline" href={FRONTEND_URL}
          >Open DEML</a
        >
        <a class="suite-btn viking-btn viking-btn-ghost" data-variant="ghost" href="/blog/"
          >Blue Notes</a
        >
      </div>
    </section>

    <section class="community-showcases" aria-labelledby="showcases-title">
      <header class="viking-unified-section-header suite-landing-section-header">
        <span class="section-tag suite-landing-tag">OPEN EXAMPLES</span>
        <h2 id="showcases-title">Reference platforms</h2>
        <p>
          Two production systems the community uses as living examples — a control plane and a
          streaming data plane.
        </p>
      </header>
      <div class="community-showcase-grid viking-panel-grid" data-columns="2">
        {showcases.map((item) => (
          <a class="community-showcase-card viking-card suite-card" href={item.href}>
            <span class="section-tag">{item.tag}</span>
            <div class="community-showcase-card-title">
              <VikingIcon name={item.icon} size={24} />
              <h3>{item.title}</h3>
            </div>
            <p>{item.summary}</p>
            <span class="community-showcase-cta">
              {item.cta}
              <VikingIcon name="chevron_right" size={18} />
            </span>
          </a>
        ))}
      </div>
    </section>

    <section class="community-resources" aria-labelledby="resources-title">
      <header class="viking-unified-section-header suite-landing-section-header">
        <span class="section-tag suite-landing-tag">RESOURCES</span>
        <h2 id="resources-title">Learn with the community</h2>
        <p>Field notes, the book, and the whitepaper — community content without product chrome.</p>
      </header>
      <ul class="community-resource-list viking-stack">
        {resources.map((item) => (
          <li>
            <a class="community-resource-link viking-card suite-card" href={item.href}>
              <VikingIcon name={item.icon} size={20} />
              <div>
                <strong>{item.title}</strong>
                <span>{item.description}</span>
              </div>
              <VikingIcon name="chevron_right" size={18} class="community-resource-arrow" />
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Layout>
