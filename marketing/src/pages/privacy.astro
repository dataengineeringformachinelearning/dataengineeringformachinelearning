---
import Layout from '../layouts/Layout.astro';
import { siteEnv } from '../lib/site-env';
import { webPageJsonLd, canonicalHref } from '../lib/seo';

const { MARKETING_URL } = siteEnv();
const pageTitle = 'Privacy Policy — DEML';
const pageDescription =
  'How DEML collects, processes, retains, and protects personal data — including GDPR rights and cookie practices.';
const privacyJsonLd = webPageJsonLd(
  pageTitle,
  pageDescription,
  canonicalHref('/privacy', MARKETING_URL),
);
const supportEmail = 'support@dataengineeringformachinelearning.com';
---

<Layout
  title={pageTitle}
  description={pageDescription}
  keywords="DEML privacy policy, GDPR, data protection, cookies, personal data retention"
  jsonLd={privacyJsonLd}
>
  <div class="page page--prose">
    <section class="banner" data-variant="hero" aria-labelledby="privacy-main-heading">
      <p class="preheader">Legal</p>
      <h1 class="banner-heading" id="privacy-main-heading">Privacy</h1>
      <p class="lede">Last updated June 7, 2026.</p>
    </section>

    <section class="page-body page-body--prose stack" aria-labelledby="privacy-body">
      <article class="article" id="privacy-policy-document">
        <div class="article-body" id="privacy-body">
          <h2 id="sec-introduction">1. Introduction</h2>
          <p>
            DEML ("we", "our", or "us") protects your privacy. This policy explains how we collect,
            use, and safeguard personal information when you use our sites, documentation, or
            status services.
          </p>
          <p>
            We practice privacy by design: collect the minimum, process only as needed, and follow
            GDPR and CCPA/CPRA where they apply.
          </p>

          <h2 id="sec-cookies">2. Cookies</h2>
          <p>
            We use cookies for security and sessions, theme preference, and optional analytics when
            you consent.
          </p>
          <ul>
            <li><strong>Necessary</strong> — security, sessions, core navigation.</li>
            <li><strong>Analytics</strong> — load and usage signals after consent.</li>
            <li><strong>Preferences</strong> — theme and similar choices.</li>
          </ul>
          <p>
            <button
              type="button"
              class="button button--secondary button--pill"
              id="privacy-open-cookie-settings"
              onclick="if(window.DemlWidgets) window.DemlWidgets.openCookieSettings()"
            >
              Cookie preferences
            </button>
          </p>

          <h2 id="gdpr">3. GDPR</h2>
          <p>
            If you are in the EU or EEA, you may request access, rectification, erasure, restriction,
            or portability of personal data we hold.
          </p>
          <form class="stack" id="gdpr-form">
            <label class="text-field" for="gdpr-email">
              <span class="text-field__label">Email</span>
              <input
                type="email"
                id="gdpr-email"
                name="email"
                autocomplete="email"
                required
                class="text-field__control"
              />
            </label>
            <label class="text-field" for="gdpr-type">
              <span class="text-field__label">Request type</span>
              <select id="gdpr-type" name="request_type" class="text-field__control" required>
                <option value="" disabled selected>Select</option>
                <option value="export">Export</option>
                <option value="delete">Delete</option>
                <option value="rectify">Rectify</option>
              </select>
            </label>
            <label class="text-field" for="gdpr-details">
              <span class="text-field__label">Details (optional)</span>
              <textarea id="gdpr-details" name="details" rows="3" class="text-field__control"></textarea>
            </label>
            <button type="submit" class="button button--primary button--pill" id="privacy-submit-gdpr-request">
              Email request
            </button>
            <p class="callout" id="gdpr-success-callout" role="status" hidden>
              Your email app is opening. Send the drafted message to complete the request.
            </p>
          </form>
          <p>
            Or email <a href={`mailto:${supportEmail}`}>{supportEmail}</a> directly.
          </p>

          <h2 id="sec-ccpa">4. CCPA / CPRA</h2>
          <p>
            California residents may know what we collect, opt out of sale or sharing (we do not sell
            personal information), limit sensitive use, and receive equal service when exercising
            rights.
          </p>

          <h2 id="sec-security">5. Security and retention</h2>
          <p>
            Traffic uses TLS 1.3. Secrets are encrypted at rest. Status pages and telemetry stay
            private until you publish a status page. Aged telemetry is purged on a retention schedule.
          </p>

          <h2 id="sec-contact">6. Contact</h2>
          <p>
            Questions or appeals:
            <a href={`mailto:${supportEmail}`}>{supportEmail}</a>
            ·
            <a href="https://joealongi.dev/" target="_blank" rel="noopener noreferrer">Joe Alongi</a>
          </p>
        </div>
      </article>
    </section>
  </div>
</Layout>

<script is:inline define:vars={{ supportEmail }}>
  document.addEventListener('DOMContentLoaded', () => {
    const gdprForm = document.getElementById('gdpr-form');
    const successCallout = document.getElementById('gdpr-success-callout');
    if (gdprForm instanceof HTMLFormElement) {
      gdprForm.addEventListener('submit', (e) => {
        e.preventDefault();
        if (!gdprForm.reportValidity()) return;

        const formData = new FormData(gdprForm);
        const email = String(formData.get('email') || '').trim();
        const requestType = String(formData.get('request_type') || '').trim();
        const details = String(formData.get('details') || '').trim();
        const subject = `Privacy request: ${requestType}`;
        const body = [
          `Request type: ${requestType}`,
          `Reply-to email: ${email}`,
          '',
          'Additional details:',
          details || 'None provided.',
        ].join('\n');

        if (successCallout) {
          successCallout.hidden = false;
        }
        window.location.href =
          `mailto:${supportEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      });
    }
  });
</script>
