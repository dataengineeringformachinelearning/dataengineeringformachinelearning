---
import Layout from '../layouts/Layout.astro';
import { siteEnv } from '../lib/site-env';
import { webPageJsonLd, canonicalHref } from '../lib/seo';

const { MARKETING_URL } = siteEnv();
const pageTitle = 'Terms — DEML';
const pageDescription =
  'Terms of service and acceptable use for the DEML platform and community site.';
const termsJsonLd = webPageJsonLd(pageTitle, pageDescription, canonicalHref('/terms', MARKETING_URL));
const supportEmail = 'support@dataengineeringformachinelearning.com';
---

<Layout
  title={pageTitle}
  description={pageDescription}
  keywords="DEML terms of service, acceptable use, legal agreement"
  jsonLd={termsJsonLd}
>
  <div class="page page--prose">
    <section class="banner" data-variant="hero" aria-labelledby="terms-main-heading">
      <p class="preheader">Legal</p>
      <h1 class="banner-heading" id="terms-main-heading">Terms</h1>
      <p class="lede">Last updated June 13, 2026.</p>
    </section>

    <section class="page-body page-body--prose stack" aria-labelledby="terms-body">
      <article class="article" id="terms-conditions-document">
        <div class="article-body" id="terms-body">
          <h2 id="sec-agreement">1. Agreement</h2>
          <p>
            These terms are a binding agreement between you and Data Engineering for Machine Learning
            concerning access to our website, documentation, and platform services. If you do not
            agree, do not use the site.
          </p>

          <h2 id="sec-intellectual-property">2. Intellectual property</h2>
          <p>
            Unless otherwise indicated, the site, content, and marks are our proprietary property or
            licensed to us. They are provided for your information and personal use. Commercial
            exploitation requires our prior written permission.
          </p>

          <h2 id="sec-user-representations">3. Your representations</h2>
          <ul>
            <li>Information you submit is accurate and kept current.</li>
            <li>You have legal capacity and will comply with these terms.</li>
            <li>You will not access the site through unauthorized bots or automation.</li>
            <li>You will not use the site for illegal or unauthorized purposes.</li>
          </ul>

          <h2 id="sec-prohibited-activities">4. Prohibited activities</h2>
          <ul>
            <li>Systematic scraping to build a competing collection without permission.</li>
            <li>Circumventing security features.</li>
            <li>Unauthorized framing or linking.</li>
            <li>Interfering with the site or connected networks.</li>
            <li>Reverse engineering software that comprises the site.</li>
          </ul>

          <h2 id="sec-liability">5. Limitation of liability</h2>
          <p>
            To the fullest extent permitted by law, we are not liable for direct, indirect,
            consequential, or punitive damages arising from your use of the site, even if advised of
            the possibility of such damages.
          </p>

          <h2 id="sec-governing-law">6. Governing law</h2>
          <p>
            These terms are governed by the laws of our operating jurisdiction. Disputes are subject
            to the exclusive jurisdiction of the competent courts.
          </p>

          <h2 id="sec-contact">7. Contact</h2>
          <p>
            <a href={`mailto:${supportEmail}`}>{supportEmail}</a>
            ·
            <a href="https://joealongi.dev/" target="_blank" rel="noopener noreferrer">Joe Alongi</a>
          </p>
        </div>
      </article>
    </section>
  </div>
</Layout>
